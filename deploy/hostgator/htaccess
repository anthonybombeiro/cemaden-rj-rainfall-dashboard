Options +ExecCGI -Indexes
AddHandler cgi-script .cgi
DirectoryIndex index.html

RewriteEngine On
RewriteRule ^api/(.*)$ /django.cgi/api/$1 [L,QSA]
# Django Admin (edicao de cotas, tipos de acionamento de sirene etc.)
RewriteRule ^admin(/.*)?$ /django.cgi/admin$1 [L,QSA]
# Pagina de historico por estacao (Next export gera estacao.html, sem
# extensao/pasta navegavel — link em Dados Meteorologicos abre /estacao?id=N).
RewriteRule ^estacao/?$ /estacao.html [L]

# Compressao pros GeoJSON de REDECs/municipios (2026-09-27, ~325KB+216KB
# sem gzip) e demais estaticos — no-op se mod_deflate nao existir no host.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json application/geo+json text/javascript application/javascript text/css
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  # IMPORTANTE (2026-09-30): por EXTENSÃO de arquivo (FilesMatch), não por
  # Content-Type (ExpiresByType) — "ExpiresByType application/json" pegava
  # TAMBÉM as respostas dinâmicas da API (/api/* roteado pro django.cgi
  # acima), fazendo o navegador cachear por 24h dados que acabaram de
  # mudar (achado: edição de SireneAcaoTipo no Admin não aparecia pro
  # usuário mesmo já salva no banco). FilesMatch só bate em arquivo
  # estático de verdade servido pelo Apache — nunca a saída do CGI.
  <FilesMatch "\.(json|geojson)$">
    ExpiresDefault "access plus 1 day"
  </FilesMatch>
</IfModule>
